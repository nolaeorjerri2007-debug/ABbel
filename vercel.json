{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.abbel.cc" },
        { "key": "Access-Control-Allow-Methods", "value": "POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dify-api/(.*)",
      "destination": "https://api.dify.ai/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}